# auchan-mcp: variáveis de ambiente
# Com o plugin supermercados-mcp, o ficheiro é criado e aberto sozinho na primeira vez:
#   Windows: %USERPROFILE%\.supermercados-mcp\credentials.env
#   macOS/Linux: ~/.supermercados-mcp/credentials.env
# Sem o plugin, podes pôr as duas linhas abaixo nesse ficheiro ou em ~/.auchan-mcp/credentials.env.
# Esse ficheiro nunca vai para o git. A pesquisa funciona sem ele.

# Necessárias para o carrinho (get_cart, add_to_cart, update_cart_item).
# AUCHAN_EMAIL=tu@exemplo.pt
# AUCHAN_PASSWORD=a-tua-palavra-passe

# As seguintes definem-se no "env" do servidor no cliente MCP, não no ficheiro acima.

# Outro ficheiro de credenciais (por omissão: o do plugin e depois ~/.auchan-mcp/credentials.env).
# AUCHAN_ENV_PATH=C:\caminho\para\credentials.env

# Outra pasta para a sessão guardada e a cache (por omissão: ~/.auchan-mcp).
# AUCHAN_STATE_DIR=C:\caminho\para\pasta

# Põe false só para ver o browser durante o login, ao procurar um problema.
# AUCHAN_LOGIN_HEADLESS=true
