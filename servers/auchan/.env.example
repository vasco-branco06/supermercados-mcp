# auchan-mcp: variáveis de ambiente
# Copia as duas primeiras linhas para um ficheiro privado:
#   Windows: %USERPROFILE%\.auchan-mcp\credentials.env
#   macOS/Linux: ~/.auchan-mcp/credentials.env
# Esse ficheiro nunca vai para o git. A pesquisa funciona sem ele.

# Necessárias para o carrinho (get_cart, add_to_cart, update_cart_item).
# AUCHAN_EMAIL=tu@exemplo.pt
# AUCHAN_PASSWORD=a-tua-palavra-passe

# As seguintes definem-se no "env" do servidor no cliente MCP, não no ficheiro acima.

# Outra pasta para credenciais, cookies e cache (por omissão: ~/.auchan-mcp).
# AUCHAN_STATE_DIR=C:\caminho\para\pasta

# Põe false só para ver o browser durante o login, ao procurar um problema.
# AUCHAN_LOGIN_HEADLESS=true
