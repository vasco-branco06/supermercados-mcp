# pingo-doce-mcp environment variables
# Copy the two login lines to a private file:
#   ~/.pingodoce-mcp/credentials.env   (Windows: %USERPROFILE%\.pingodoce-mcp\credentials.env)
#
# Keep the real file outside the repo and never commit it.
# Without this file the server only offers search_products and close_session.

# Required for the cart tools.
# PINGODOCE_EMAIL=you@example.com
# PINGODOCE_PASSWORD=your-password

# Optional: use a different credentials file. Set it in your MCP client's server "env".
# PINGODOCE_ENV_PATH=/absolute/path/to/credentials.env

# Optional: different folder for credentials.env, cookies.json and the search cache.
# PINGODOCE_STATE_DIR=/absolute/path/to/state

# Set to false only for local debugging, to watch the login browser.
# PINGODOCE_LOGIN_HEADLESS=true
