{
  "name": "pingo-doce-mcp",
  "version": "0.3.0",
  "description": "MCP server for Pingo Doce (pingodoce.pt): search products and manage your cart.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pingo-doce-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "playwright install chromium",
    "test": "node --test",
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:cheerio --external:playwright --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pingo-doce",
    "supermarket",
    "portugal"
  ],
  "author": "Vasco Branco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasco-branco06/supermercados-mcp.git"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0"
  },
  "optionalDependencies": {
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
